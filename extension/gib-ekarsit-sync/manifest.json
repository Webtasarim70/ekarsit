{
  "manifest_version": 3,
  "name": "e-Karşıt GİB Senkronizasyon",
  "version": "1.0.0",
  "description": "GİB e-Karşıt gönderilen kayıtlarını tüm sayfalarıyla alıp e-Karşıt Takip uygulamasına aktarır.",
  "permissions": [
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://eymm.gib.gov.tr/*",
    "https://dijital.gib.gov.tr/*",
    "https://webtasarim70.github.io/ekarsit/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eymm.gib.gov.tr/*"
      ],
      "js": [
        "gib-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://eymm.gib.gov.tr/portal/karsitIncelemeTutanagi*"
      ],
      "js": [
        "gib-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dijital.gib.gov.tr/*"
      ],
      "js": [
        "gib-tebligat-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dijital.gib.gov.tr/portal/e-tebligat*"
      ],
      "js": [
        "gib-tebligat-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://webtasarim70.github.io/ekarsit/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "app-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
